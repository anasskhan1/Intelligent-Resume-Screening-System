AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
BACKEND_SERVICE_URL=http://localhost:8080
TEMP_UPLOAD_DIR=ai-service-python/temp
MAX_UPLOAD_SIZE_BYTES=10485760
LOG_LEVEL=INFO

