# =============================================================================
# Spring Boot Backend - Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# =============================================================================

SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/resume_screening_db
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

# Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=20000
DB_POOL_MAX_LIFETIME_MS=1800000

# Integration & Storage
AI_SERVICE_BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=200MB
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

