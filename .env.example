# =============================================================================
# Intelligent Resume Screening System - Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# =============================================================================

# --- Database Configuration (MySQL 8.0) ---
DB_NAME=resume_screening_db
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=your_mysql_root_password_here
DB_USERNAME=resumes_app
DB_PASSWORD=your_mysql_app_password_here

# HikariCP Connection Pool
DB_POOL_MAX_SIZE=25
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=20000
DB_POOL_MAX_LIFETIME_MS=1800000

# --- Java Spring Boot Backend Service ---
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/resume_screening_db
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=500MB
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ISSUER=intelligent-resume-screening-system
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Python AI Microservice ---
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
BACKEND_SERVICE_URL=http://localhost:8080
TEMP_UPLOAD_DIR=ai-service-python/temp
MAX_UPLOAD_SIZE_BYTES=10485760
LOG_LEVEL=INFO

# --- Frontend Web Client ---
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8080
