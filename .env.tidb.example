# ==============================================================================
# TiDB Cloud Starter Configuration Template
# Copy this file to .env.tidb and fill in your actual credentials.
# Do NOT commit .env.tidb to Git.
# ==============================================================================

TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=resume_screening_db
TIDB_USERNAME=your_tidb_username_prefix.root
TIDB_PASSWORD=your_tidb_password

# Optional: Dedicated Truststore (if not using Java 17 built-in ISRG Root X1)
# TIDB_TRUSTSTORE_PATH=certs/tidb-truststore.p12
# TIDB_TRUSTSTORE_PASSWORD=changeit

